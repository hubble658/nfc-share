<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal button: softer than the filled primary, clearly different from outlined ones -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/color_ripple_on_surface">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primary_container" />
            <corners android:radius="@dimen/size_corner_radius_button" />
        </shape>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/color_section_title</item>
        <item name="android:textSize">@dimen/size_text_section_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/size_margin_vertical_buttons</item>
        <item name="android:minHeight">@dimen/size_button_min_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textColorHint">@color/color_hint</item>
        <item name="android:textSize">@dimen/size_text_buttons</item>
        <item name="android:textCursorDrawable">@drawable/cursor_primary</item>
    </style>

    <style name="OutlineButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/size_button_min_height</item>
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textSize">@dimen/size_text_buttons</item>
    </style>

    <style name="InfoText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/color_hint</item>
        <item name="android:textSize">@dimen/size_text_error</item>
    </style>

    <style name="AboutGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>
</resources>

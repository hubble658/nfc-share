    <string name="about_privacy_internet_body">The links, WiFi passwords and contacts you save are stored only on this phone. They are never sent to any server.</string>
    <string name="about_privacy_nfc_title">Only sent when you tap</string>
    <string name="about_privacy_nfc_body">Data is only transferred over NFC when you hold your phone against another device. Sharing stops by itself when the time you picked runs out.</string>
    <string name="about_permission_location_title">Location</string>
    <string name="about_permission_location_body">Android only shows the name of your connected WiFi network to apps with location permission. NFC Share never reads or stores your location.</string>
    <string name="about_permission_contacts_title">Contacts</string>
    <string name="about_permission_contacts_body">Only used when you tap \"Pick From Contacts\", to fill in the name, number and email of the contact you pick.</string>
    <string name="about_permission_nfc_title">NFC</string>
    <string name="about_permission_nfc_body">Used to send what you picked to the phone you hold it against.</string>
